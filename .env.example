# --- Base de données ---
# Production : PostgreSQL managé (Neon, Supabase, Railway…).
# CETTE VARIABLE EST OBLIGATOIRE SUR VERCEL ; sinon le déploiement échoue.
DATABASE_URL=postgres://user:password@host:5432/autostock

# Démo locale SANS serveur PostgreSQL (un seul processus à la fois) :
# DATABASE_URL=pglite://./data/autostock.db

# --- Authentification (off par défaut; activer via /parametres) ---
# Secret HMAC des cookies de session. Obtenir avec: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret
# Compte administrateur créé au premier démarrage si absent
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Internationalisation ---
NEXT_PUBLIC_APP_NAME=AutoStock
NEXT_PUBLIC_CURRENCY=DA
